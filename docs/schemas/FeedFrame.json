{
  "description": "A raw frame (metadata) captured from a camera feed.",
  "properties": {
    "intersection_id": {
      "description": "Unique ID for this intersection (e.g., 'hcm.q1.nvc-lelai').",
      "title": "Intersection Id",
      "type": "string"
    },
    "site_id": {
      "description": "Cluster or region ID used for routing.",
      "title": "Site Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "description": "Version of the event schema.",
      "title": "Schema Version",
      "type": "integer"
    },
    "event_ts": {
      "description": "Timestamp when the event was produced at the source.",
      "format": "date-time",
      "title": "Event Ts",
      "type": "string"
    },
    "ingest_ts": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Timestamp when the bus received it. Measures end-to-end latency.",
      "title": "Ingest Ts"
    },
    "camera_id": {
      "description": "Unique identifier for the camera/feed (e.g., 'N', 'S', 'E', 'W').",
      "title": "Camera Id",
      "type": "string"
    },
    "frame_shape": {
      "description": "Shape of the frame array (height, width, channels).",
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "title": "Frame Shape",
      "type": "array"
    }
  },
  "required": [
    "camera_id",
    "frame_shape"
  ],
  "title": "FeedFrame",
  "type": "object"
}